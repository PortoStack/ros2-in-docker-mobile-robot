# =============================================================================
# Medbot Environment Configuration Template
# Copy this file to '.env.local' to customize local settings without committing secrets
# =============================================================================

# Docker build target stage ('development' or 'production')
DOCKER_TARGET=development

# ROS 2 Network & Middleware Configuration
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Hardware Serial Ports (Host system device paths)
ESP32_SERIAL_PORT=/dev/ttyUSB0
ESP32_BAUDRATE=115200
YDLIDAR_SERIAL_PORT=/dev/ttyUSB1

# Services & Ports
FOXGLOVE_PORT=8765
GUI_PORT=3000
